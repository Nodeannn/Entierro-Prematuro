    isExtremoHorror: 0
    isMuyFeliz: 0
    isChicaInterposicion: 0
    isChicaFeliz: 0
    isChicaColgada: 0
    isChicaNeutro: 0
    isAsustadoHablando: 0
  - speaker: Padre
    text: "Mi hija tuvo su primera fiesta de quince. Cuando me lo cont\xF3... sent\xED
      miedo."
    isMirandoAbajo: 0
    isMirandoCostado: 0
    isMirandoDerecha: 0
    isAbajo: 0
    isHablando1: 0
    isHablando2: 0
    isMedioFeliz: 0
    isConmovido: 0
    isFeliz: 0
    isEnojado: 0
    isMasEnojado: 0
    isHablandoMuyEnojado: 0
    isHablandoEnojado: 0
    isMedioTriste: 0
    isLlorando: 0
    isTriste: 0
    isPreocupado: 0
    isAsustarse: 0
    isAsustado: 0
    isExtremoEnojado: 0
    isExtremoQCY: 0
    isExtremoHorror: 0
    isMuyFeliz: 0
    isChicaInterposicion: 0
    isChicaFeliz: 0
    isChicaColgada: 0
    isChicaNeutro: 0
    isAsustadoHablando: 0
  - speaker: Padre
    text: "Era de noche, yo iba a estar durmiendo... Y pens\xE9 en quedarme despierto,
      incluso en hablar con el padre de la cumplea\xF1era."
    isMirandoAbajo: 0
    isMirandoCostado: 0
    isMirandoDerecha: 0
    isAbajo: 0
    isHablando1: 0
    isHablando2: 0
    isMedioFeliz: 0
    isConmovido: 0
    isFeliz: 1
    isEnojado: 0
    isMasEnojado: 0
    isHablandoMuyEnojado: 0
    isHablandoEnojado: 0
    isMedioTriste: 0
    isLlorando: 0
    isTriste: 0
    isPreocupado: 0
    isAsustarse: 0
    isAsustado: 0
    isExtremoEnojado: 0
    isExtremoQCY: 0
    isExtremoHorror: 0
    isMuyFeliz: 0
    isChicaInterposicion: 0
    isChicaFeliz: 0
    isChicaColgada: 0
    isChicaNeutro: 0
    isAsustadoHablando: 0
  - speaker: Padre
    text: "Dios, no puedo creer que consider\xE9 eso. Pero al final, la dej\xE9 ir.
      Y me fui a dormir."
    isMirandoAbajo: 0
    isMirandoCostado: 0
    isMirandoDerecha: 0
