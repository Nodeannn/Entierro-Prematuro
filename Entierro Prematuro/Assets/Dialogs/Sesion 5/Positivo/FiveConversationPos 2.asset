    isMasEnojado: 0
    isHablandoMuyEnojado: 0
    isHablandoEnojado: 0
    isMedioTriste: 0
    isLlorando: 0
    isTriste: 0
    isPreocupado: 0
    isAsustarse: 0
    isAsustado: 0
    isExtremoEnojado: 0
