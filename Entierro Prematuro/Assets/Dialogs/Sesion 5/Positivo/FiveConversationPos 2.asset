    isChicaNeutro: 0
    isAsustadoHablando: 0
  - speaker: Psiquiatra
    text: "Obviamente, para eso estoy yo. Escucharle y ayudarle. \xBFQu\xE9 quiere
      decirme?"
    isMirandoAbajo: 0
    isMirandoCostado: 0
    isMirandoDerecha: 0
    isAbajo: 0
    isHablando1: 0
    isHablando2: 0
    isMedioFeliz: 0
    isConmovido: 1
    isFeliz: 0
