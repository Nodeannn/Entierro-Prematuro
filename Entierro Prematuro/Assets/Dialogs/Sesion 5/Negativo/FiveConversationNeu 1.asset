    isMuyFeliz: 0
    isChicaInterposicion: 0
    isChicaFeliz: 0
    isChicaColgada: 0
    isChicaNeutro: 0
    isAsustadoHablando: 0
  - speaker: Padre
    text: "\xA1Yo a vos no te creo nada! \xBFTe crees que soy tan tonto como para
      darme cuenta que reci\xE9n ahora vos me ven\xEDs a decir esa cosa de mi hija?"
    isMirandoAbajo: 0
    isMirandoCostado: 0
    isMirandoDerecha: 0
    isAbajo: 0
    isHablando1: 0
    isHablando2: 0
    isMedioFeliz: 0
    isConmovido: 0
    isFeliz: 0
    isEnojado: 0
    isMasEnojado: 0
    isHablandoMuyEnojado: 1
    isHablandoEnojado: 0
    isMedioTriste: 0
    isLlorando: 0
    isTriste: 0
    isPreocupado: 0
    isAsustarse: 0
    isAsustado: 0
    isExtremoEnojado: 0
