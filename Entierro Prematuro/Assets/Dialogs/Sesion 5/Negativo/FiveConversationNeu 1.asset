    isMirandoCostado: 0
    isMirandoDerecha: 0
    isAbajo: 0
    isHablando1: 0
    isHablando2: 0
    isMedioFeliz: 0
    isConmovido: 0
    isFeliz: 0
    isEnojado: 0
    isMasEnojado: 1
    isHablandoMuyEnojado: 0
    isHablandoEnojado: 0
    isMedioTriste: 0
    isLlorando: 0
    isTriste: 0
    isPreocupado: 0
    isAsustarse: 0
    isAsustado: 0
