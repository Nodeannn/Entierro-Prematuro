  lines:
  - speaker: Padre
    text: "\xA1Mentirosa! \xA1Me estas mintiendo ac\xE1 en la cara! \xBFTe crees
      que no me doy cuenta no? \xA1Solo quer\xE9s que yo no siga m\xE1s en este mundo!"
    isMirandoAbajo: 0
    isMirandoCostado: 0
    isMirandoDerecha: 0
    isAbajo: 0
    isHablando1: 0
    isHablando2: 0
    isMedioFeliz: 0
    isConmovido: 0
    isFeliz: 0
    isEnojado: 0
    isMasEnojado: 0
    isHablandoMuyEnojado: 1
    isHablandoEnojado: 0
    isMedioTriste: 0
    isLlorando: 0
    isTriste: 0
    isPreocupado: 0
    isAsustarse: 0
    isAsustado: 0
