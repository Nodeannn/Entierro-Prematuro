    isChicaInterposicion: 0
    isChicaFeliz: 0
    isChicaColgada: 0
    isChicaNeutro: 0
    isAsustadoHablando: 0
  - speaker: Padre
    text: "\xA1Cerr\xE1 la boca! \xA1No! Quer\xE9s hacerme creer que yo mat\xE9 a
