    isMirandoCostado: 0
    isMirandoDerecha: 0
    isAbajo: 0
    isHablando1: 0
    isHablando2: 0
    isMedioFeliz: 0
    isConmovido: 0
    isFeliz: 0
    isEnojado: 0
    isMasEnojado: 0
    isHablandoMuyEnojado: 1
    isHablandoEnojado: 0
    isMedioTriste: 0
    isLlorando: 0
    isTriste: 0
